  "requirements": [
    {
      "id": "S1",
      "text": "Live transcription via Web Speech API in Chrome; words appear as spoken; typed fallback always present",
      "type": "functional",
      "priority": "must",
      "source": "user",
      "status": "AGREED",
      "added": "2026-09-03T20:43:56Z"
    },
    {
      "id": "S2",
      "text": "Five scam-script markers (authority, threat, isolation, demand, blocking) score risk 0-100, weighted, capped, monotonically non-decreasing during a call",
      "type": "functional",
      "priority": "must",
      "source": "user",
      "status": "AGREED",
      "added": "2026-09-03T20:43:57Z"
    },
    {
      "id": "S3",
      "text": "Deterministic offline scam taxonomy names the call among >=8 scam families with a sourced statistic",
      "type": "functional",
      "priority": "must",
      "source": "user",
      "status": "AGREED",
      "added": "2026-09-03T20:43:57Z"
    },
    {
      "id": "S4",
      "text": "Interview flow (not a warning banner): ask who the money is for and why, classify the answer, name the exact scam back",
      "type": "functional",
      "priority": "must",
      "source": "user",
      "status": "AGREED",
      "added": "2026-09-03T20:43:57Z"
    },
    {
      "id": "S5",
      "text": "Writes calls and detections to Firestore; another screen subscribed via onSnapshot sees the update within one second",
      "type": "functional",
      "priority": "must",
      "source": "user",
      "status": "AGREED",
      "added": "2026-09-03T20:43:58Z"
    },
    {
      "id": "S6",
      "text": "Upload audio -> real/fake verdict via pretrained wav2vec2 model or offline acoustic-forensics fallback with measured numbers shown",
      "type": "functional",
      "priority": "should",
      "source": "user",
      "status": "AGREED",
      "added": "2026-09-03T20:43:58Z"
    },
    {
      "id": "S7",
      "text": "Upload image -> real/fake verdict via pretrained ViT face-deepfake model with confidence shown",
      "type": "functional",
      "priority": "should",
      "source": "user",
      "status": "AGREED",
      "added": "2026-09-03T20:43:58Z"
    },
    {
      "id": "S8",
      "text": "Caller Attestation: an unattested authority claim is shown as 'no police unit has attested a call to you'",
      "type": "functional",
      "priority": "should",
      "source": "user",
      "status": "AGREED",
      "added": "2026-09-03T20:43:58Z"
    },
    {
      "id": "S9",
      "text": "Live risk meter 0-100 visible with each of the five markers lighting individually as detected",
      "type": "functional",
      "priority": "must",
      "source": "user",
      "status": "AGREED",
      "added": "2026-09-03T20:43:59Z"
    },
    {
      "id": "C1",
      "text": "SHIELD writes only to its own Firestore collections (calls, detections); reads users; never writes another module's collection",
      "type": "constraint",
      "priority": "must",
      "source": "user",
      "status": "AGREED",
      "added": "2026-09-03T20:43:59Z"
    },
    {
      "id": "C2",
      "text": "Never run two microphone consumers (recorder + recogniser) at the same time",
      "type": "constraint",
      "priority": "must",
      "source": "user",
      "status": "AGREED",
      "added": "2026-09-03T20:43:59Z"
    },
    {
      "id": "C3",
      "text": "Model weights for voice/face deepfake detection are downloaded and cached before the event; app degrades to the acoustic fallback if the model service or wifi is down",
      "type": "non-functional",
      "priority": "should",
      "source": "user",
      "status": "AGREED",
      "added": "2026-09-03T20:44:00Z"
    },
    {
      "id": "C4",
      "text": "Every classifier (markers, taxonomy) is pure and deterministic, unit-testable without network or ML models",
